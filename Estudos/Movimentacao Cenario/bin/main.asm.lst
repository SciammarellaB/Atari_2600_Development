    200  f0f9							; CENARIO - 24 faixas de 8 linhas = 192 linhas.
    201  f0f9							; Cada bit ligado desenha uma parede com largura de 4 pixels do TIA.
    202  f0f9							; Ordem da esquerda para a direita: PF0 bits 4..7, PF1 bits 7..0,
    203  f0f9							; PF2 bits 0..7. CTRLPF espelha esses 20 blocos na metade direita.
    204  f0f9							; As tabelas ficam na ROM; nao ocupam os 128 bytes de RAM.
    205  f0f9							; Este desenho e visual: a colisao com as paredes ainda nao e tratada.
    206  f100		       00 00 00 00*	      align	256	; evita ciclos extras nas leituras com indice Y
    207  f100				   ScenePF0
    208  f100		       f0 10 10 10*	      byte.b	$F0, $10, $10, $10, $10, $10, $10, $10
    209  f108		       10 10 00 00*	      byte.b	$10, $10, $00, $00, $00, $00, $10, $10
    210  f110		       10 10 10 10*	      byte.b	$10, $10, $10, $10, $10, $10, $10, $F0
    211  f118				   ScenePF1
