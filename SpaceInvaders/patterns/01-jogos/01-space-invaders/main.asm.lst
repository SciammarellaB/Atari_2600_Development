    232  f1a5							; --- Nova partida: quatro vivos, nave centralizada, nenhum tiro ---
    233  f1a5							; Esta rotina tambem atende Game Reset e o reinicio depois do fim da partida.
    234  f1a5							; FireReady=0 evita que o tiro que encerrou a partida reinicie automaticamente.
    235  f1a5				   NewGame
    236  f1a5		       a9 4c		      lda	#76
    237  f1a7		       85 80		      sta	ShipX
    238  f1a9		       85 81		      sta	ShotX
    239  f1ab		       a9 80		      lda	#Offscreen
    240  f1ad		       85 82		      sta	ShotY
    241  f1af		       a9 20		      lda	#32
    242  f1b1		       85 83		      sta	FleetX
    243  f1b3		       a9 0c		      lda	#12
    244  f1b5		       85 84		      sta	FleetY
    245  f1b7		       a9 01		      lda	#1
    246  f1b9		       85 85		      sta	Direction
    247  f1bb		       a2 03		      ldx	#3
    248  f1bd				   Revive
    249  f1bd		       95 90		      sta	Alive,x
    250  f1bf		       ca		      dex
    251  f1c0		       10 fb		      bpl	Revive
    252  f1c2		       a9 04		      lda	#4
    253  f1c4		       85 87		      sta	Remaining
    254  f1c6		       a9 00		      lda	#0
    255  f1c8		       85 88		      sta	State
    256  f1ca		       85 86		      sta	MoveClock
    257  f1cc		       85 8b		      sta	FireReady
    258  f1ce		       85 8c		      sta	SoundClock
    259  f1d0		       8d 00 00 	      sta	AUDV0
    260  f1d3		       8d 00 00 	      sta	COLUBK
    261  f1d6		       60		      rts
    262  f1d7
    263  f1d7							; --- Entrada e estados: Game Reset funciona a qualquer momento ---
    264  f1d7							; O bit 0 de SWCHB e ativo em zero. Nos estados finais, soltar e apertar
    265  f1d7							; tiro reinicia; durante a partida, segurar tiro permite disparos sucessivos.
    266  f1d7				   UpdateGame
    267  f1d7		       ad 00 00 	      lda	SWCHB
    268  f1da		       29 01		      and	#1
    269  f1dc		       d0 03		      bne	CheckState
    270  f1de		       4c a5 f1 	      jmp	NewGame
    271  f1e1				   CheckState
    272  f1e1		       a5 88		      lda	State
    273  f1e3		       f0 12		      beq	PlayingFrame
    274  f1e5		       ad 00 00 	      lda	INPT4
    275  f1e8		       10 05		      bpl	RestartPressed
    276  f1ea		       a9 01		      lda	#1
    277  f1ec		       85 8b		      sta	FireReady
    278  f1ee		       60		      rts
    279  f1ef				   RestartPressed
    280  f1ef		       a5 8b		      lda	FireReady
    281  f1f1		       f0 03		      beq	UpdateDone
    282  f1f3		       4c a5 f1 	      jmp	NewGame
    283  f1f6				   UpdateDone
    284  f1f6		       60		      rts
    285  f1f7
    286  f1f7							; --- Som curto: o volume zera quando o contador termina ---
    287  f1f7							; O mesmo canal toca o disparo ou o impacto mais recente. Nao ha musica.
    288  f1f7				   PlayingFrame
    289  f1f7		       a5 8c		      lda	SoundClock
    290  f1f9		       f0 09		      beq	ReadMovement
    291  f1fb		       c6 8c		      dec	SoundClock
    292  f1fd		       d0 05		      bne	ReadMovement
    293  f1ff		       a9 00		      lda	#0
    294  f201		       8d 00 00 	      sta	AUDV0
    295  f204
    296  f204							; --- Movimento horizontal da nave, um pixel por quadro ---
    297  f204							; BIT testa as mascaras de esquerda/direita sem alterar A. Limites 16..144
    298  f204							; deixam margem para escrever os registradores antes dos objetos aparecerem.
    299  f204				   ReadMovement
    300  f204		       a6 80		      ldx	ShipX
    301  f206		       a9 40		      lda	#$40
    302  f208		       2c 00 00 	      bit	SWCHA
    303  f20b		       d0 05		      bne	ReadRight
    304  f20d		       e0 10		      cpx	#MinShipX
    305  f20f		       f0 01		      beq	ReadRight
    306  f211		       ca		      dex
    307  f212				   ReadRight
    308  f212		       a9 80		      lda	#$80
    309  f214		       2c 00 00 	      bit	SWCHA
    310  f217		       d0 05		      bne	SaveMovement
    311  f219		       e0 90		      cpx	#MaxShipX
    312  f21b		       f0 01		      beq	SaveMovement
    313  f21d		       e8		      inx
    314  f21e				   SaveMovement
    315  f21e		       86 80		      stx	ShipX
    316  f220
    317  f220							; --- Atualizacao da formacao e do tiro ---
    318  f220							; Primeiro move os invasores, depois o tiro e finalmente testa a colisao.
    319  f220							; Uma derrota encerra o quadro logico sem permitir outro disparo.
    320  f220		       20 bd f2 	      jsr	MoveFleet
    321  f223		       a5 88		      lda	State
    322  f225		       d0 cf		      bne	UpdateDone
    323  f227		       a5 82		      lda	ShotY
    324  f229		       c9 80		      cmp	#Offscreen
    325  f22b		       f0 10		      beq	TryFire
    326  f22d		       c9 02		      cmp	#2
    327  f22f		       90 08		      bcc	RemoveShot
    328  f231		       38		      sec
    329  f232		       e9 02		      sbc	#2	; sobe quatro linhas fisicas por quadro
    330  f234		       85 82		      sta	ShotY
    331  f236		       4c 61 f2 	      jmp	CheckHits
    332  f239				   RemoveShot
    333  f239		       a9 80		      lda	#Offscreen
    334  f23b		       85 82		      sta	ShotY
    335  f23d				   TryFire
    336  f23d		       ad 00 00 	      lda	INPT4
    337  f240		       30 b4		      bmi	UpdateDone
    338  f242		       a5 80		      lda	ShipX
    339  f244		       18		      clc
    340  f245		       69 03		      adc	#3	; tiro alinhado com o centro da nave de oito pixels
    341  f247		       85 81		      sta	ShotX
    342  f249		       a9 56		      lda	#ShipY-2
    343  f24b		       85 82		      sta	ShotY
    344  f24d		       a9 04		      lda	#4	; onda tonal para o disparo
    345  f24f		       8d 00 00 	      sta	AUDC0
    346  f252		       a9 0c		      lda	#12
    347  f254		       8d 00 00 	      sta	AUDF0
    348  f257		       a9 05		      lda	#5
    349  f259		       8d 00 00 	      sta	AUDV0
    350  f25c		       a9 05		      lda	#5
    351  f25e		       85 8c		      sta	SoundClock
    352  f260		       60		      rts
    353  f261
    354  f261							; --- Colisao com os quatro invasores, todos visiveis em cada quadro ---
    355  f261							; Cada vivo tem retangulo 8 pixels x 8 pares; o tiro mede 2 pixels x 2 pares.
    356  f261							; (tiro - inicio + 1) < 9 aceita deltas -1..7: inclui a largura/altura do tiro.
    357  f261							; X percorre a fileira inferior primeiro. Uma colisao consome exatamente um tiro.
    358  f261				   CheckHits
    359  f261		       a2 03		      ldx	#3
    360  f263				   HitLoop
    361  f263		       b5 90		      lda	Alive,x
    362  f265		       f0 52		      beq	NextTarget
    363  f267		       a5 83		      lda	FleetX
    364  f269		       18		      clc
    365  f26a		       7d 10 f5 	      adc	ColumnOffsets,x
    366  f26d		       85 96		      sta	HitX
    367  f26f		       a5 84		      lda	FleetY
    368  f271		       18		      clc
    369  f272		       7d 14 f5 	      adc	RowOffsets,x
    370  f275		       85 97		      sta	HitY
    371  f277		       a5 81		      lda	ShotX
    372  f279		       38		      sec
    373  f27a		       e5 96		      sbc	HitX
