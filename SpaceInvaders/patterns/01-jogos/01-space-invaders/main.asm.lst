------- FILE main.asm LEVEL 1 PASS 3
      1  10000 ????						; Space Invaders basico: ROM de 4 KiB, CPU 6507, sintaxe DASM, video NTSC.
      2  10000 ????						; Invasores = players 0/1 no alto; nave = player 0 na base; tiro = missile 0.
      3  10000 ????						; Nao ha framebuffer: o programa acompanha a geracao de cada linha do TIA.
      4  10000 ????				       processor	6502
      5  10000 ????
      6  10000 ????				       include	"hardware.h"
      7  10000 ????
      8  10000 ????						; --- Coordenadas e limites ---
      9  10000 ????						; X usa pixels de 0..159. Y usa PARES de linhas de 0..95: um passo Y vale
     10  10000 ????						; duas linhas fisicas. Os sprites de oito bytes ficam com 16 linhas de altura.
     11  10000 ????						; Duas colunas, separadas por 48 pixels, e duas fileiras, separadas por 12 pares.
     12  10000 ????		00 58	    ShipY      =	88
     13  10000 ????		00 10	    MinShipX   =	16
     14  10000 ????		00 90	    MaxShipX   =	144
     15  10000 ????		00 10	    MinFleetX  =	16
     16  10000 ????		00 60	    MaxFleetX  =	96	; ultima coluna termina em 96 + 48 + 7 = 151
     17  10000 ????		00 80	    Offscreen  =	128	; Y fora de 0..95: missile desativado
     18  10000 ????		00 00	    Playing    =	0
     19  10000 ????		00 01	    Won        =	1
     20  10000 ????		00 02	    Lost       =	2
     21  10000 ????
     22  10000 ????						; --- RAM do RIOT, a partir de $80 ---
     23  10000 ????						; A pilha usa o espelho $0180..$01FF da mesma RAM. Estas variaveis terminam
     24  10000 ????						; em $BF, deixando espaco para JSR/RTS crescerem a partir do topo $FF.
     25  10000 ????		00 80	    ShipX      =	$80
     26  10000 ????		00 81	    ShotX      =	$81
     27  10000 ????		00 82	    ShotY      =	$82
     28  10000 ????		00 83	    FleetX     =	$83
     29  10000 ????		00 84	    FleetY     =	$84
     30  10000 ????		00 85	    Direction  =	$85	; 1 = direita; $FF = esquerda
     31  10000 ????		00 86	    MoveClock  =	$86
     32  10000 ????		00 87	    Remaining  =	$87	; quatro invasores no inicio; zero significa vitoria
     33  10000 ????		00 88	    State      =	$88	; 0 = jogando; 1 = venceu; 2 = perdeu
     34  10000 ????		00 8a	    DisplayX   =	$8A
     35  10000 ????		00 8b	    FireReady  =	$8B	; exige soltar o botao antes de reiniciar uma partida
     36  10000 ????		00 8c	    SoundClock =	$8C
     37  10000 ????		00 8d	    NextLeft   =	$8D	; pixels da coluna esquerda preparados antecipadamente
     38  10000 ????		00 8e	    NextShot   =	$8E
     39  10000 ????		00 8f	    NextRight  =	$8F
     40  10000 ????		00 90	    Alive      =	$90	; quatro bytes: superior [0..1], inferior [2..3]
     41  10000 ????		00 96	    HitX       =	$96	; limites temporarios para a colisao por retangulos
     42  10000 ????		00 97	    HitY       =	$97
     43  10000 ????		00 98	    LeftPixels =	$98	; 20 bytes: sprite de 8, intervalo de 4, sprite de 8
     44  10000 ????		00 ac	    RightPixels =	$AC	; outros 20 bytes: coluna direita, sem alternar quadros
     45  10000 ????
     46  10000 ????						; --- Inicializacao do console ---
     47  10000 ????						; SEI/CLD preparam a CPU. A limpeza escreve somente TIA ($00..$7F) e RAM
     48  10000 ????						; ($80..$FF), sem tocar na ROM. O RIOT recebe SWACNT=0 para ler o joystick.
     49  f000					      org	$F000
     50  f000				   Reset
     51  f000		       78		      sei
     52  f001		       d8		      cld
     53  f002		       a2 ff		      ldx	#$FF
     54  f004		       9a		      txs
     55  f005		       a9 00		      lda	#0
     56  f007				   ClearMemory
     57  f007		       95 00		      sta	$00,x
     58  f009		       ca		      dex
     59  f00a		       d0 fb		      bne	ClearMemory
     60  f00c		       85 00		      sta	$00
     61  f00e		       8d 00 00 	      sta	SWACNT
     62  f011		       a9 10		      lda	#$10	; missile de dois pixels, nave em tamanho normal
     63  f013		       8d 00 00 	      sta	NUSIZ0
     64  f016		       a9 0e		      lda	#$0E	; nave e tiro brancos
     65  f018		       8d 00 00 	      sta	COLUP0
     66  f01b		       a9 c8		      lda	#$C8	; invasores verdes na paleta NTSC
     67  f01d		       8d 00 00 	      sta	COLUP1
     68  f020		       20 a5 f1 	      jsr	NewGame
     69  f023		       a9 02		      lda	#2
     70  f025		       8d 00 00 	      sta	VBLANK
