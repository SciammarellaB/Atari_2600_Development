     72  f02b
     73  f02b							; --- Quadro NTSC: 3 + 37 + 192 + 30 = 262 linhas ---
     74  f02b							; VSYNC dura tres linhas. TIM64T=44 chega a zero em (44-1)*64+1 ciclos:
     75  f02b							; o primeiro decremento do RIOT ocorre apos um ciclo, os demais apos 64.
     76  f02b							; A expiracao ocorre na 37a linha; WSYNC alinha o inicio da regiao visivel.
     77  f02b				   Frame
     78  f02b		       a9 02		      lda	#2
     79  f02d		       8d 00 00 	      sta	VSYNC
     80  f030		       8d 00 00 	      sta	WSYNC
     81  f033		       8d 00 00 	      sta	WSYNC
     82  f036		       8d 00 00 	      sta	WSYNC
     83  f039		       a9 00		      lda	#0
     84  f03b		       8d 00 00 	      sta	VSYNC
     85  f03e		       a9 2c		      lda	#44
     86  f040		       8d 00 00 	      sta	TIM64T
     87  f043		       20 d7 f1 	      jsr	UpdateGame
     88  f046		       20 11 f3 	      jsr	PrepareSprites
     89  f049
     90  f049							; --- Posicionamento dos tres objetos durante a imagem oculta ---
     91  f049							; X escolhe o registrador: 0=P0, 1=P1, 2=M0. O missile precisa receber
     92  f049							; coordenada +1 pela diferenca entre o reset de players e de misseis do TIA.
     93  f049							; HMOVE so e escrito imediatamente depois de WSYNC, no inicio da linha.
     94  f049		       a5 83		      lda	FleetX
     95  f04b		       a2 00		      ldx	#0
     96  f04d		       20 00 f4 	      jsr	PositionObject
     97  f050		       a5 8a		      lda	DisplayX
     98  f052		       a2 01		      ldx	#1
     99  f054		       20 00 f4 	      jsr	PositionObject
    100  f057		       a5 81		      lda	ShotX
    101  f059		       18		      clc
    102  f05a		       69 01		      adc	#1
    103  f05c		       a2 02		      ldx	#2
    104  f05e		       20 00 f4 	      jsr	PositionObject
