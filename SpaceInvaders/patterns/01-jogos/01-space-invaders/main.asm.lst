    113  f076		       85 8e		      sta	NextShot
    114  f078		       a9 c8		      lda	#$C8
    115  f07a		       8d 00 00 	      sta	COLUP0
    116  f07d		       8d 00 00 	      sta	COLUP1
    117  f080		       a2 00		      ldx	#0
    118  f082				   WaitBlank
    119  f082		       ad 00 00 	      lda	INTIM
    120  f085		       d0 fb		      bne	WaitBlank
    121  f087		       8d 00 00 	      sta	WSYNC
    122  f08a		       8d 00 00 	      sta	VBLANK	; A=0 permite a imagem; X=0 inicia o primeiro par
    123  f08d		       4c 00 f1 	      jmp	DrawPair	; pula o preenchimento inserido por ALIGN
    124  f090
    125  f090							; --- Kernel superior: 84 pares = 168 linhas, quatro invasores sem flicker ---
    126  f090							; Cada player desenha uma coluna nos MESMOS quadros. Entre as duas fileiras,
    127  f090							; o buffer contem zeros. Escrevemos os desenhos antes do pixel X=16 aparecer.
    128  f090							; A linha A prepara os pixels do proximo par; B prepara seu tiro. ALIGN evita
    129  f090							; penalidades de pagina nos desvios. Nenhuma linha ultrapassa 76 ciclos.
    130  f100		       00 00 00 00*	      align	256
    131  f100				   DrawPair
    132  f100		       a5 8d		      lda	NextLeft
    133  f102		       8d 00 00 	      sta	GRP0
    134  f105		       a5 8f		      lda	NextRight
    135  f107		       8d 00 00 	      sta	GRP1
    136  f10a		       a5 8e		      lda	NextShot
    137  f10c		       8d 00 00 	      sta	ENAM0
    138  f10f
    139  f10f							; --- Prepara as duas colunas do proximo par ---
    140  f10f							; Delta negativo vira byte alto e tambem e excluido por CMP #20. O mesmo
    141  f10f							; indice Y seleciona as duas imagens; cada buffer ja considera os mortos.
    142  f10f		       e8		      inx
    143  f110		       8a		      txa
    144  f111		       38		      sec
    145  f112		       e5 84		      sbc	FleetY
    146  f114		       c9 14		      cmp	#20
    147  f116		       b0 0c		      bcs	AliensBlank
    148  f118		       a8		      tay
    149  f119		       b9 98 00 	      lda	LeftPixels,y
    150  f11c		       85 8d		      sta	NextLeft
    151  f11e		       b9 ac 00 	      lda	RightPixels,y
    152  f121		       4c 28 f1 	      jmp	SaveRight
    153  f124				   AliensBlank
    154  f124		       a9 00		      lda	#0
    155  f126		       85 8d		      sta	NextLeft
    156  f128				   SaveRight
    157  f128		       85 8f		      sta	NextRight
    158  f12a		       8d 00 00 	      sta	WSYNC	; termina A, comeca B; os pixels permanecem no TIA
    159  f12d
    160  f12d							; --- Tiro do proximo par, quatro linhas fisicas de altura ---
    161  f12d							; ENAM0 recebe 2 dentro do retangulo ou 0 fora. Y=128 desativa o tiro.
    162  f12d		       8a		      txa
    163  f12e		       38		      sec
    164  f12f		       e5 82		      sbc	ShotY
    165  f131		       c9 02		      cmp	#2
    166  f133		       a9 00		      lda	#0
    167  f135		       b0 02		      bcs	SaveShot
    168  f137		       a9 02		      lda	#2
    169  f139				   SaveShot
    170  f139		       85 8e		      sta	NextShot
    171  f13b		       8d 00 00 	      sta	WSYNC	; termina B
    172  f13e		       e0 54		      cpx	#84
    173  f140		       d0 be		      bne	DrawPair
    174  f142
    175  f142							; --- Faixa de troca: oito linhas reservadas, de 168 ate 175 ---
    176  f142							; O player 0 deixa a coluna esquerda e passa a nave. Ocultamos somente esta
    177  f142							; faixa para reposicionar sem desenhar residuos. O tiro tambem fica oculto
    178  f142							; ao atravessa-la. HMCLR zera ajustes antigos: HMOVE deve mover apenas P0.
    179  f142							; TIM64T=10 chega a zero em 577 ciclos, na oitava linha desta faixa.
    180  f142							; O WSYNC seguinte inicia a nave na linha 176 da regiao visivel.
    181  f142		       a9 02		      lda	#2
    182  f144		       8d 00 00 	      sta	VBLANK
    183  f147		       a9 0a		      lda	#10
    184  f149		       8d 00 00 	      sta	TIM64T
    185  f14c		       a9 00		      lda	#0
    186  f14e		       8d 00 00 	      sta	GRP0
    187  f151		       8d 00 00 	      sta	GRP1
    188  f154		       8d 00 00 	      sta	ENAM0
    189  f157		       8d 00 00 	      sta	HMCLR
    190  f15a		       a5 80		      lda	ShipX
    191  f15c		       a2 00		      ldx	#0
    192  f15e		       20 00 f4 	      jsr	PositionObject
    193  f161		       8d 00 00 	      sta	WSYNC
    194  f164		       8d 00 00 	      sta	HMOVE
    195  f167		       a9 0e		      lda	#$0E
    196  f169		       8d 00 00 	      sta	COLUP0	; nave branca; o tiro compartilha esta cor no rodape
    197  f16c		       a2 00		      ldx	#0
    198  f16e				   WaitShip
    199  f16e		       ad 00 00 	      lda	INTIM
    200  f171		       d0 fb		      bne	WaitShip
    201  f173		       8d 00 00 	      sta	WSYNC
    202  f176		       8d 00 00 	      sta	VBLANK	; A=0, permite as ultimas 16 linhas da regiao visivel
    203  f179
    204  f179							; --- Nave: oito pares = 16 linhas, de 176 ate 191 ---
    205  f179							; O bitmap fornece oito pixels por linha. O tiro pode nascer acima da nave;
    206  f179							; nesta regiao ele ja esta desativado, pois seu Y inicial e ShipY-2.
    207  f179				   DrawShip
    208  f179		       bd 00 f5 	      lda	ShipBitmap,x
    209  f17c		       8d 00 00 	      sta	GRP0
    210  f17f		       8d 00 00 	      sta	WSYNC
    211  f182		       8d 00 00 	      sta	WSYNC
    212  f185		       e8		      inx
    213  f186		       e0 08		      cpx	#8
    214  f188		       d0 ef		      bne	DrawShip
    215  f18a
    216  f18a							; --- Overscan: 30 linhas com a imagem oculta ---
    217  f18a							; Apagar GRP0/GRP1/ENAM0 impede residuos no proximo quadro. Toda a logica
    218  f18a							; fica em VBLANK; aqui o contador garante exatamente 30 linhas adicionais.
    219  f18a		       a9 02		      lda	#2
    220  f18c		       8d 00 00 	      sta	VBLANK
    221  f18f		       a9 00		      lda	#0
    222  f191		       8d 00 00 	      sta	GRP0
    223  f194		       8d 00 00 	      sta	GRP1
    224  f197		       8d 00 00 	      sta	ENAM0
    225  f19a		       a2 1e		      ldx	#30
